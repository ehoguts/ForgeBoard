# Local development examples only. Copy to .env; never commit real credentials.
# Use URL-safe characters here because Compose constructs the database URL.
POSTGRES_USER=forgeboard
POSTGRES_PASSWORD=forgeboard_local_only
POSTGRES_DB=forgeboard
APP_ORIGIN=http://localhost:5173
# HTTP localhost only; the backend's standalone default is true.
COOKIE_SECURE=false
SESSION_TTL_HOURS=24
