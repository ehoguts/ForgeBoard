FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS build
RUN apk upgrade --no-cache && npm install --global npm@12.2.2 --no-audit --no-fund
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS caddy-build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /build
COPY infra/runtime/caddy/go.mod infra/runtime/caddy/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download && go mod verify
COPY infra/runtime/caddy/main.go ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -mod=readonly -trimpath -ldflags="-s -w" -o /out/caddy .

FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf
ENV XDG_CONFIG_HOME=/config XDG_DATA_HOME=/data
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates \
    && addgroup -S -g 10001 forgeboard && adduser -S -D -u 10001 -G forgeboard forgeboard \
    && mkdir -p /srv /data /config /etc/caddy && chown -R 10001:10001 /srv /data /config
COPY --from=caddy-build /out/caddy /usr/bin/caddy
COPY --from=build --chown=10001:10001 /app/dist /srv
COPY --chown=10001:10001 infra/runtime/Caddyfile /etc/caddy/Caddyfile
USER 10001:10001
WORKDIR /srv
EXPOSE 8080 8443
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
